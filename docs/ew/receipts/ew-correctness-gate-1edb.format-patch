++const segment = { from: { x: 0, y: 0 }, to: { x: 0, y: 0 } };
+ export function stepHojFlight(shot, dt, readSignal) {
+-  const from = { x: shot.x, y: shot.y };
+-  if (shot.dead) return { from, to: from };
++  segment.from.x = shot.x; segment.from.y = shot.y;
