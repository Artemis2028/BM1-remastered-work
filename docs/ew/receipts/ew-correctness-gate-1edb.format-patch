diff --git a/docs/ew/receipts/review-20260913-ship-ew-probe.log b/docs/ew/receipts/review-20260913-ship-ew-probe.log
new file mode 100644
index 0000000..a239a7f
--- /dev/null
+++ b/docs/ew/receipts/review-20260913-ship-ew-probe.log
@@ -0,0 +1,37 @@
+
+> broken-mirror-1@0.0.1 test:ew:ingame
+> node scripts/ship-ew-probe.mjs
+
+PASS real engine freezes
+PASS new captain starts empty without changing three weapon slots
+PASS module 1 rejects below faction standing
+PASS module 1 purchases at tier and charges once
+PASS module 1 cannot be rebought
+PASS module 2 rejects below faction standing
+PASS module 2 purchases at tier and charges once
+PASS module 2 cannot be rebought
+PASS module 3 rejects below faction standing
+PASS module 3 purchases at tier and charges once
+PASS module 3 cannot be rebought
+PASS docked transmit order refused
+PASS real jammer control enables requested module
+PASS paid field begins after spin-up and consumes energy
+PASS foreign receiver measures paid interference
+PASS jamming changes no weapons, standing or attack evidence
+PASS Off removes field immediately
+PASS own fleet interference is named in real panel
+PASS ECCM raises local quality and records actual draw
+PASS foreign refit rejected
+PASS local escort and garrison use same standing gate
+PASS remote commanded ship refit rejected
+PASS save restores player module, manual ECCM and energy
+PASS fleet save restores equipment and order without refill
+PASS pre-EW save gets empty captain/fleet equipment
+PASS Fleet emission is detected beyond comms without identity
+PASS cloak switches captain jammer Off
+PASS capture retains module but clears former operating orders
+PASS ambient replacement drops old equipment and operating state
+PASS actual DOM jammer order works
+PASS actual DOM ECCM order works
+PASS real station type records give military platforms enhanced arrays
+32/32 live EW checks passed
diff --git a/docs/ew/receipts/review-20260913-ship-ew-test.log b/docs/ew/receipts/review-20260913-ship-ew-test.log
new file mode 100644
index 0000000..b5ab877
--- /dev/null
+++ b/docs/ew/receipts/review-20260913-ship-ew-test.log
@@ -0,0 +1,26 @@
+
+> broken-mirror-1@0.0.1 test:ew
+> node scripts/ship-ew-test.mjs
+
+PASS catalog uses existing 15/30/75 tiers and reviewed prices
+PASS noise-free and zero receiver cases remain finite
+PASS single and stacked Fleet jammer figures, without old ceiling
+PASS fourth and subsequent emitter contribute; ordering does not change quality
+PASS friendly interference is real and attributable; cancellation is self only
+PASS edge and beyond have no interference
+PASS better ECCM recovers range; military platform burns through
+PASS spin-up spends energy and emits before interference
+PASS all electronics receive the same fraction without order theft
+PASS capacity overflow pays same-step electronics; no free generation
+PASS frame subdivisions have equal energy and activation
+PASS Off has two-second restart delay plus paid spin-up
+PASS cloak/docking block forces Off, zero Sensors cannot transmit
+PASS snapshot carries orders/timers but no paid live field
+PASS seeded equipment independent of faction skill; civilians and command start empty
+PASS four crew skills use power/recovery rather than hardware discounts
+PASS jammed reacquisition completes after a prior local track is lost
+PASS maximum interference preserves visual edges, checkpoint coverage and radio declarations
+PASS new jammer emission needs its own one-second acquisition even on a visually tracked hull
+crew-energy-traces {"inexperienced":[94.12,83.32,72.52,61.72,50.92,40.12,29.32,18.52,7.72,2.92,4.12,5.32,6.52,7.72,2.92,4.12,5.32,6.52,7.72,2.92,4.12,5.32,6.52,7.72,2.92,4.12,5.32,6.52,7.72,2.92],"regular":[94.12,83.32,72.52,61.72,50.92,40.12,29.32,30.52,25.72,26.92,28.12,29.32,24.52,25.72,26.92,28.12,29.32,24.52,25.72,26.92,28.12,29.32,24.52,25.72,26.92,28.12,29.32,24.52,25.72,26.92],"veteran":[94.12,83.32,72.52,61.72,59.56,57.4,61,58.84,56.68,60.28,58.12,55.96,59.56,57.4,55.24,58.84,55.24,58.84,55.24,58.84,55.24,58.84,55.24,58.84,55.24,58.84,55.24,58.84,55.24,58.84],"elite":[94.12,90.52,89.8,91.96,91.24,89.08,91.24,90.52,89.8,91.96,91.24,89.08,91.24,90.52,89.8,91.96,91.24,89.08,91.24,90.52,89.8,91.96,91.24,89.08,91.24,90.52,89.8,91.96,91.24,89.08]}
