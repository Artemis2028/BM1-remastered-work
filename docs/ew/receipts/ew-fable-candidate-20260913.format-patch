++From f76f90c973835f4e6dc34d7c11160401fbfc20ad Mon Sep 17 00:00:00 2001
++From: Cursor Agent <cursoragent@cursor.com>
++Date: Sun, 13 Sep 2026 20:22:09 +0000
++Subject: [PATCH 3/7] EW: lock seeker identity, collision lists, idle pass and
++ timing names
++
++Invalidate cached HOJ keys on spawn-seed change so same-object ambient
++replacements cannot be reacquired. Build one unfiltered collision list
++per projectile update and exclude the shooter inside pointImpact.
++Restore detection-pass elapsedMs/passMs, record updateMs and gate the
++power-plus-sensors electronicsPass. Reuse frozen zero-noise reception,
++observer pass stamps, and a transition-safe jamAcquire clear. Warn
++before a command-hull purchase discards the installed jammer.
++
++Co-authored-by: Artemis2028 <Artemis2028@users.noreply.github.com>
++---
++ scripts/ew-frame-benchmark.mjs     | 27 ++++++++----
++ scripts/sensor-frame-benchmark.mjs | 24 ++++++++---
++ scripts/ship-ew-probe.mjs          | 15 ++++++-
++ scripts/ship-ew-test.mjs           |  8 +++-
++ scripts/ship-hoj-probe.mjs         | 19 +++++++++
++ src/main.js                        | 44 +++++++++++++-------
++ src/ship-ew.mjs                    |  4 ++
++ src/ship-sensors.mjs               | 66 +++++++++++++++++++-----------
++ styles.css                         |  6 +++
++ 9 files changed, 155 insertions(+), 58 deletions(-)
++
++diff --git a/scripts/ew-frame-benchmark.mjs b/scripts/ew-frame-benchmark.mjs
++index ef1d5b2..a3c13f8 100644
++--- a/scripts/ew-frame-benchmark.mjs
+++++ b/scripts/ew-frame-benchmark.mjs
++@@ -139,7 +139,7 @@ try {
++         B.updateSensorSystems(12);
++         await new Promise(r => setTimeout(r, 200));
++       }
++-      const passes = [],seekers = [],sensorOnly=[];
+++      const electronics = [],seekers = [],detectionOnly=[],sensorUpdates=[];
++       const seekerOutliers=[],seekerHist={lt0_25:0,lt0_5:0,lt1:0,lt2:0,lt4:0,ge4:0};
++       let seekerHits=0,seekerDeaths=0,seekerMax=0;
++       window.__ewSeekProf={player:0,station:0,ship:0};
++@@ -152,8 +152,9 @@ try {
++         seekers.push(seekerDone-t);
++         B.updatePowerSystems(12);
++         B.updateSensorSystems(12);
++-        passes.push(performance.now()-seekerDone);
++-        sensorOnly.push(B.sensorWorld.metrics.elapsedMs);
+++        electronics.push(performance.now()-seekerDone);
+++        detectionOnly.push(B.sensorWorld.metrics.passMs ?? B.sensorWorld.metrics.elapsedMs);
