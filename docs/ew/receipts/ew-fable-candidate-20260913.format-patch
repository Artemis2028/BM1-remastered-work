+++node $HARNESS --root /tmp/ew-passms-tree-a --passes > $RECEIPT_DIR/${STAMP}-presensor.json
+++
+++# B — sensors, ordinary torpedoes
+++git -C /workspace worktree add --detach /tmp/ew-passms-tree-b e7aa3c594e4799c54d48e2eeac37a2a1acf36b9b
+++node $HARNESS --root /tmp/ew-passms-tree-b --passes > $RECEIPT_DIR/${STAMP}-sensors.json
+++
+++# C1 — paid noise/ECCM, ordinary torpedoes
+++git -C /workspace worktree add --detach /tmp/ew-passms-tree-c1 74caf837c7882a86e3bd7c74f083029453953c1a
+++node $HARNESS --root /tmp/ew-passms-tree-c1 --passes > $RECEIPT_DIR/${STAMP}-commit1.json
+++
+++# C2 — current review tip (this checkout)
+++node $HARNESS --root /workspace --passes > $RECEIPT_DIR/${STAMP}-ew-tip.json
+++
+++git -C /workspace worktree remove --force /tmp/ew-passms-tree-a /tmp/ew-passms-tree-b /tmp/ew-passms-tree-c1
