{
  "name": "broken-mirror-1",
  "version": "0.0.1",
  "description": "A browser-playable remaster of FlashTrek: Broken Mirror 1 on the BM2 engine.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build-release.mjs",
    "build:python": "python3 scripts/build_release.py",
    "serve": "python3 -m http.server 8001",
    "release:serve": "python3 -m http.server 8001 --directory dist",
    "clean": "rm -rf dist dist-chrome-extension",
    "probe": "node scripts/behavior-probe.mjs",
    "validate:ships": "node bm-ships/validate.mjs",
    "test:ships": "node scripts/ship-catalog-integration-test.mjs"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
